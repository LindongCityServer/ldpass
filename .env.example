NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL="file:./data/ldpass.sqlite"
AUTH_COOKIE_DOMAIN=".example.com"
SESSION_SECRET="replace-with-a-long-random-secret"
# 更换加密密钥前，把旧值填入 LEGACY，解密失败时会自动回退到旧密钥。
# 注意：PROVIDER_API_KEY_SECRET 同时用于 API Key 的 HMAC 指纹，更换后已发出的 API Key 必须重新签发。
PROVIDER_API_KEY_SECRET="replace-with-a-long-random-provider-api-key-secret"
PROVIDER_API_KEY_SECRET_LEGACY=""
OPEN_API_RATE_LIMIT_WINDOW_SECONDS=60
OPEN_API_RATE_LIMIT_MAX_REQUESTS=120
WEBHOOK_SECRET_ENCRYPTION_KEY="replace-with-a-long-random-webhook-secret-encryption-key"
WEBHOOK_SECRET_ENCRYPTION_KEY_LEGACY=""
WEBHOOK_DISPATCH_ENABLED=true
WEBHOOK_DISPATCH_INTERVAL_SECONDS=30
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=8
WEBHOOK_MAX_ATTEMPTS=5
ACTION_LINK_EXPIRY_SWEEP_ENABLED=true
ACTION_LINK_EXPIRY_SWEEP_INTERVAL_SECONDS=60
ACTION_LINK_EXPIRY_SWEEP_BATCH_SIZE=100
PASSWORD_PEPPER="replace-with-a-long-random-password-pepper"
PIN_PEPPER="replace-with-a-long-random-pepper"
# 双 pepper 平滑迁移：先把旧的 PASSWORD_PEPPER / PIN_PEPPER 原样填入 *_LEGACY，
# 再把上面两个换成新的随机值；用户下次成功登录或校验 PIN 时会自动用新 pepper 重算哈希。
# 确认所有用户与发卡方账号都已迁移后，再删除这两个 LEGACY 变量。
PASSWORD_PEPPER_LEGACY=""
PIN_PEPPER_LEGACY=""

# 登录与 PIN 失败限流（内存实现，进程重启后计数清零）
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_LOGIN_IP_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LOCK_SECONDS=900
AUTH_PIN_MAX_ATTEMPTS=5
AUTH_PIN_WINDOW_SECONDS=900
AUTH_PIN_LOCK_SECONDS=900

# 反向代理：部署在 Nginx/BT 面板之后保持 true；直接暴露公网时设为 false，
# 避免客户端伪造 X-Forwarded-For 影响审计与风控。
TRUST_PROXY_HEADERS=true

# 本地开发免密管理员登录，默认关闭；仅在开发环境需要时设为 1
LDPASS_LOCAL_DEV_ADMIN_LOGIN=0
BDSLM_BASE_URL="http://ld.cmsy.xyz:19136"
BDSLM_POLL_INTERVAL_MS=1000
BDSLM_REQUEST_TIMEOUT_MS=5000
STORAGE_ALERT_MIN_FREE_BYTES=10737418240
STORAGE_ALERT_MIN_FREE_RATIO=0.15
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
